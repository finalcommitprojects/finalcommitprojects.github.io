---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  updated: string;
}
const { title, description, updated } = Astro.props;
---

<Base title={title} description={description}>
  <article class="sec legal" aria-labelledby="legal-title">
    <div class="wrap">
      <p class="eyebrow">Last updated {updated}</p>
      <h1 id="legal-title"><span class="dot filled" aria-hidden="true"></span>{title}</h1>
      <div class="prose">
        <slot />
      </div>
      <p class="others">
        Also read: <a href="/terms/">Terms</a> · <a href="/refunds/">Refund policy</a> · <a href="/privacy/">Privacy</a>
      </p>
    </div>
  </article>
</Base>

<style>
  .legal {
    padding-top: clamp(28px, 5vw, 64px);
  }
  h1 {
    margin-top: 12px;
    font-size: clamp(2.1rem, 1.4rem + 3vw, 3.4rem);
  }
  .prose {
    max-width: 44em;
    margin-top: 28px;
  }
  .prose :global(h2) {
    margin: 36px 0 10px;
    font-family: var(--f-body);
    font-size: 1.2rem;
    letter-spacing: 0;
  }
  .prose :global(p),
  .prose :global(li) {
    color: var(--ink-2);
  }
  .prose :global(p + p) {
    margin-top: 12px;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 10px 0 0;
    padding-left: 1.3em;
  }
  .prose :global(li + li) {
    margin-top: 6px;
  }
  .prose :global(strong) {
    color: var(--ink);
  }
  .prose :global(table) {
    width: 100%;
    margin-top: 12px;
    border-collapse: collapse;
  }
  .prose :global(th),
  .prose :global(td) {
    padding: 10px 8px;
    border-bottom: 1px solid var(--rule-strong);
    text-align: left;
    vertical-align: top;
  }
  .prose :global(th) {
    font-family: var(--f-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-2);
    border-bottom: 2px solid var(--ink);
  }
  .others {
    margin-top: 48px;
    font-size: 0.95rem;
    color: var(--ink-2);
  }
</style>
