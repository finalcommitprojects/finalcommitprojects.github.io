---
import { wa } from '../data/site';
import Icon from './Icon.astro';

const help: [string, string][] = [
  ['A paper about your project', 'Abstract, literature survey, method, results and conclusion, written around the work you actually did.'],
  ['Real results', "Tables and graphs from your project's own results. We don't make up numbers."],
  ["In your journal's format", 'IEEE, Springer or whatever template your journal or conference asks for, with references in its style.'],
  ['Checked for similarity', 'Written fresh for your paper, and checked for similarity before you submit it.'],
  ['A genuine journal or conference', 'We help you choose one, and steer you away from journals that publish anything for a fee.'],
  ['Reviewer comments', 'If the reviewers ask for changes, we help you answer them and revise the paper.'],
];
---

<section class="sec" id="papers" aria-labelledby="papers-title">
  <div class="wrap">
    <div class="sec-head">
      <h2 id="papers-title"><span class="dot" aria-hidden="true"></span>Need to publish a research paper?</h2>
      <p>
        Many colleges now want a paper along with the project. We help you write one about your own work. You're the author, so we make
        sure you can explain every part of it.
      </p>
    </div>

    <ul class="cards">
      {
        help.map(([t, d]) => (
          <li>
            <h3>{t}</h3>
            <p>{d}</p>
          </li>
        ))
      }
    </ul>

    <div class="foot">
      <p>
        Nobody can promise a journal will accept a paper; that's the reviewers' call. You get a written quote first, and you pay only after
        you've seen the work.
      </p>
      <a
        class="btn btn-wa"
        data-umami-event="whatsapp"
        data-umami-event-location="papers"
        href={wa('Hi Final Commit, I need help writing a research paper about my project.')}
        ><Icon name="wa" />Help with my paper</a
      >
    </div>
  </div>
</section>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cards li {
    padding: 18px 18px 20px;
    background: var(--paper-2);
    border-top: 3px solid var(--ink);
    border-radius: 2px;
  }
  h3 {
    margin-bottom: 6px;
    font-size: 1.05rem;
  }
  .cards p {
    color: var(--ink-2);
    font-size: 0.97rem;
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
    margin-top: 28px;
  }
  .foot p {
    flex: 1 1 380px;
    max-width: 40em;
    color: var(--ink-2);
  }
  @media (max-width: 759px) {
    .cards {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .cards li {
      padding: 7px 12px;
      border-top: 0;
      border: 1px solid var(--rule-strong);
      border-radius: 999px;
    }
    .cards h3 {
      margin: 0;
      font-size: 0.88rem;
      font-weight: 500;
    }
    .cards p {
      display: none;
    }
    .foot {
      margin-top: 18px;
    }
    .foot p {
      flex-basis: 100%;
      font-size: 0.92rem;
    }
  }
</style>
