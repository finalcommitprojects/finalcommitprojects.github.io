---
import { site } from '../data/site';

const faqs: [string, string][] = [
  [
    "How do I know this is genuine and you won't disappear with my money?",
    "You don't pay anything until your guide approves the synopsis. After that you pay in three parts, each after you've seen the work: the approved synopsis, a working demo on a video call, and setup on your laptop. From your first payment you also get read access to your private GitHub repo, so you can watch the project being built. And you can video call us before you decide anything.",
  ],
  [
    'How much does a project cost?',
    "Most projects fall within a published range for their area, for example ₹5,000 to ₹8,000 for a web app or ₹2,500 to ₹4,000 for a mini project. The full table is under how paying works. After a free call you get a written quote, before you pay anything, and it doesn't change once you accept it.",
  ],
  [
    "I've already started my project. Can you help with just part of it?",
    "Yes. Send us your code (a GitHub link or a zip) and tell us what your guide wants. We can fix what's broken, add features, write the report and PPT, or prepare you for the viva on the code you already have. You get a written quote first, and you pay after you've seen the work.",
  ],
  [
    'Will someone in my college get the same project?',
    "No. Students at different colleges can pick the same idea from our list, but within your college and batch nobody gets the same one, and that's in our terms. Tell us your college on the call so we can check. Either way, the code, report and diagrams are written from scratch for you.",
  ],
  [
    "Will my report pass my college's plagiarism check?",
    "It's written for your project, not copied from an old report. Colleges check with tools like DrillBit, Turnitin or URKUND and set their own limit, often 20 to 30% for B.Tech reports. If yours is flagged over the limit, we rewrite those parts free.",
  ],
  [
    'Will I actually understand the code?',
    "Yes. The walkthrough sessions are for exactly that. We go through each module until you can explain it yourself, and the viva sheet covers the questions panels usually ask. You can also follow the build in your GitHub repo as it happens.",
  ],
  [
    'What help do I get until my viva?',
    "Changes your guide asks for until final submission, help getting the demo running before each review, reinstallation if your laptop changes, answers on WhatsApp when you're stuck on your code, and a mock viva before the real one.",
  ],
  [
    'How long does it take?',
    "From the first call, a mini project usually takes 1 to 2 weeks and a major project 3 to 6. Tell us your review date first, and we'll say on the call whether it's realistic.",
  ],
  [
    'How do you set it up on my laptop?',
    "Over a Google Meet screen share. You stay in control of your laptop the whole time: we tell you what to click. We never ask you to install remote-control apps, and we never ask for an OTP.",
  ],
  [
    "Can you follow my college's report format?",
    "Send us the template, or a senior's report. Margins, fonts, chapter order, certificate and declaration pages, all of it. VTU, Anna University, AKTU, JNTU, Mumbai University black books and autonomous colleges are all fine.",
  ],
  [
    'My guide gave me an IEEE base paper. Can you build that?',
    "Yes. Send the paper. We'll read it, tell you what can realistically be built in your time, and implement it.",
  ],
  [
    'Can I change things after we start?',
    "Small changes, any time. If the whole idea changes halfway, we agree the new timeline, and any change in price, in writing first.",
  ],
  [
    "I'm not in your city. Does that work?",
    'Everything happens online, over WhatsApp and Google Meet. We work with students anywhere in India.',
  ],
  [
    'Do you do hardware or IoT projects?',
    'We do software only. If your IoT project needs an app, a dashboard or a backend, we can build that part.',
  ],
  [
    'Is my idea kept private?',
    "Yes. Your own idea stays yours. We don't reuse it for other students or post it anywhere without asking you.",
  ],
  [
    'How many projects do you take on?',
    "A limited number each semester, so each one gets proper time. If we can't fit yours in before your deadline, we'll tell you on the first call instead of taking it anyway.",
  ],
  [
    'Do you take 2nd and 3rd year mini projects?',
    'Yes. Mini projects, semester projects and internship projects too. Most ideas on our list can be cut down to mini-project size.',
  ],
  [
    'What do you need from me to start?',
    `Your course, your deadline, the project (from our list or your own idea) and your college's report format if you have it. A WhatsApp message to ${site.phone} is enough to begin.`,
  ],
];
---

<section class="sec" id="faq" aria-labelledby="faq-title">
  <div class="wrap grid">
    <div class="sec-head">
      <h2 id="faq-title"><span class="dot" aria-hidden="true"></span>Questions students ask</h2>
    </div>

    <div class="paper">
      {
        faqs.slice(0, 6).map(([q, a], i) => (
          <details>
            <summary>
              <span class="q-no mono">Q{i + 1}</span>
              <span class="q-text">{q}</span>
              <span class="q-mark" aria-hidden="true" />
            </summary>
            <p>{a}</p>
          </details>
        ))
      }
      <details class="panel more">
        <summary data-umami-event="open-panel" data-umami-event-panel="more-faq">More questions ({faqs.length - 6})</summary>
        <div class="panel-body">
          {
            faqs.slice(6).map(([q, a], i) => (
              <details>
                <summary>
                  <span class="q-no mono">Q{i + 7}</span>
                  <span class="q-text">{q}</span>
                  <span class="q-mark" aria-hidden="true" />
                </summary>
                <p>{a}</p>
              </details>
            ))
          }
        </div>
      </details>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 8px;
  }
  @media (min-width: 1000px) {
    .grid {
      grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
      gap: 64px;
      align-items: start;
    }
  }
  .paper {
    border-top: 2px solid var(--ink);
  }
  details:not(.panel) {
    border-bottom: 1px solid var(--rule-strong);
  }
  .more {
    border-top: 0;
  }
  .more > :global(summary) {
    color: var(--ink-2);
  }
  details:not(.panel) > summary {
    display: grid;
    grid-template-columns: 46px minmax(0, 1fr) 24px;
    align-items: baseline;
    gap: 8px;
    padding: 18px 0;
    cursor: pointer;
    list-style: none;
  }
  details:not(.panel) > summary::-webkit-details-marker {
    display: none;
  }
  .q-no {
    color: var(--red);
    font-size: 0.88rem;
  }
  .q-text {
    font-weight: 600;
    font-size: 1.08rem;
  }
  details:not(.panel) > summary:hover .q-text {
    text-decoration: underline;
    text-decoration-color: var(--red);
    text-underline-offset: 3px;
  }
  .q-mark {
    position: relative;
    width: 14px;
    height: 14px;
    align-self: center;
  }
  .q-mark::before,
  .q-mark::after {
    content: '';
    position: absolute;
    left: 0;
    top: 6px;
    width: 14px;
    height: 2px;
    background: var(--ink);
    transition: transform 0.2s;
  }
  .q-mark::after {
    transform: rotate(90deg);
  }
  details[open] .q-mark::after {
    transform: rotate(0deg);
  }
  details:not(.panel) p {
    padding: 0 32px 22px 54px;
    color: var(--ink-2);
    max-width: 44em;
  }
  @media (max-width: 520px) {
    summary {
      grid-template-columns: 38px minmax(0, 1fr) 18px;
    }
    details:not(.panel) p {
      padding: 0 0 20px 46px;
    }
  }
</style>
