---
import { site } from '../data/site';

const faqs: [string, string][] = [
  [
    'How much does a project cost?',
    "It depends on the project, the tech stack and how much of the report work you need from us. Tell us what you want and we'll give you a clear price on the call. You pay in parts by UPI or bank transfer, not all at once.",
  ],
  [
    'How long does it take?',
    "A mini project usually takes 1 to 2 weeks. A major project takes 3 to 6. If your review is close, tell us the date first and we'll tell you honestly whether it can be done.",
  ],
  [
    'Will I actually understand the code?',
    "Yes. That's what the walkthrough sessions are for. We go through it with you until you can explain each module yourself, and the viva sheet covers the questions panels usually ask.",
  ],
  [
    "Can you follow my college's report format?",
    "Send us the template, or a senior's report. Margins, fonts, chapter order, certificate and declaration pages, all of it. VTU, Anna University, AKTU, JNTU, Mumbai University black books, autonomous colleges: all fine.",
  ],
  [
    'My guide gave me an IEEE base paper. Can you build that?',
    "Yes. Send the paper. We'll read it, tell you what can realistically be built in your time, and implement it. If your college wants the report in paper format, we write that too.",
  ],
  [
    'Can I change things after we start?',
    "Small changes, any time. If the whole idea changes halfway, we'll talk about the timeline again.",
  ],
  [
    "I'm not in your city. Does that work?",
    "Everything happens online, over WhatsApp, Google Meet and AnyDesk. We work with students anywhere in India.",
  ],
  [
    'Do you do hardware or IoT projects?',
    'We do software only. If your IoT project needs an app, a dashboard or a backend, we can build that part.',
  ],
  [
    'Is my idea kept private?',
    "Yes. Your own idea stays yours. We don't reuse it for other students or post it anywhere without asking you.",
  ],
  [
    'Do you take 2nd and 3rd year mini projects?',
    'Yes. Mini projects, semester projects and internship projects too. Most projects in the register can be cut down to mini-project size.',
  ],
  [
    'What do you need from me to start?',
    `Your course, your deadline, the project (from the register or your own idea) and your college's report format if you have it. A WhatsApp message to ${site.phone} is enough to begin.`,
  ],
];
---

<section class="sec" id="faq" aria-labelledby="faq-title">
  <div class="wrap grid">
    <div class="sec-head">
      <h2 id="faq-title"><span class="dot" aria-hidden="true"></span>Questions students ask</h2>
      <p class="note rubric" aria-hidden="true">answer all questions.<br />(we did.)</p>
    </div>

    <div class="paper">
      {
        faqs.map(([q, a], i) => (
          <details>
            <summary>
              <span class="q-no mono">Q{i + 1}</span>
              <span class="q-text">{q}</span>
              <span class="q-mark" aria-hidden="true" />
            </summary>
            <p>{a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 8px;
  }
  @media (min-width: 1000px) {
    .grid {
      grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
      gap: 64px;
      align-items: start;
    }
  }
  .rubric {
    transform: rotate(-2deg);
    transform-origin: left;
  }
  .paper {
    border-top: 2px solid var(--ink);
  }
  details {
    border-bottom: 1px solid var(--rule-strong);
  }
  summary {
    display: grid;
    grid-template-columns: 46px minmax(0, 1fr) 24px;
    align-items: baseline;
    gap: 8px;
    padding: 18px 0;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .q-no {
    color: var(--red);
    font-size: 0.88rem;
  }
  .q-text {
    font-weight: 600;
    font-size: 1.08rem;
  }
  summary:hover .q-text {
    text-decoration: underline;
    text-decoration-color: var(--red);
    text-underline-offset: 3px;
  }
  .q-mark {
    position: relative;
    width: 14px;
    height: 14px;
    align-self: center;
  }
  .q-mark::before,
  .q-mark::after {
    content: '';
    position: absolute;
    left: 0;
    top: 6px;
    width: 14px;
    height: 2px;
    background: var(--ink);
    transition: transform 0.2s;
  }
  .q-mark::after {
    transform: rotate(90deg);
  }
  details[open] .q-mark::after {
    transform: rotate(0deg);
  }
  details p {
    padding: 0 32px 22px 54px;
    color: var(--ink-2);
    max-width: 44em;
  }
  @media (max-width: 520px) {
    summary {
      grid-template-columns: 38px minmax(0, 1fr) 18px;
    }
    details p {
      padding: 0 0 20px 46px;
    }
  }
</style>
