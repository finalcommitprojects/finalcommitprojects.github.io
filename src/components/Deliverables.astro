---
const items: [string, string][] = [
  ['Source code', 'in your private GitHub repo, commented, yours to keep'],
  ['Database and sample data', 'set up for the demo'],
  ['Project report', "in your college's format, written for your project"],
  ['PPT for every review', 'review 1, review 2 and the final'],
  ['Synopsis and abstract', 'for your guide to approve'],
  ['UML, DFD and ER diagrams', 'as editable files'],
  ['Demo video', 'a recording of the full flow'],
  ['A way to show it', 'a live link for web and AI projects, hosted free until your viva; an installable APK for Android apps'],
  ['Setup on your laptop', 'over a Google Meet screen share, with you in control'],
  ['Code walkthrough', 'until you can explain each module yourself'],
  ['Viva questions', 'with answers, written for your project'],
];
---

<section class="sec" id="get" aria-labelledby="get-title">
  <div class="wrap grid">
    <div class="sec-head intro">
      <h2 id="get-title"><span class="dot" aria-hidden="true"></span>What you'll receive</h2>
      <p>
        Everything your college asks for at submission, and the preparation to explain it yourself. You tick these off as they
        arrive.
      </p>
    </div>

    <div class="sheet checklist">
      <p class="sheet-head"><span class="mono">Your submission checklist</span></p>
      <ul>
        {
          items.map(([name, detail]) => (
            <li>
              <span class="box" aria-hidden="true" />
              <span>
                <strong>{name}</strong> <span class="detail">{detail}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 8px;
  }
  @media (min-width: 1000px) {
    .grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 64px;
      align-items: start;
    }
  }
  .checklist {
    padding: 32px 22px 32px 0;
  }
  /* red margin inside the sheet; the ticks live in it */
  .checklist::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 46px;
    width: 1.5px;
    background: var(--red-soft);
  }
  .sheet-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-left: 62px;
  }
  .sheet-head .mono {
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    display: grid;
    grid-template-columns: 62px minmax(0, 1fr);
    align-items: start;
  }
  /* empty box: the student ticks it when the item arrives */
  .box {
    justify-self: center;
    width: 18px;
    height: 18px;
    margin-top: 7px;
    margin-left: -16px;
    border: 2px solid var(--ink-2);
    border-radius: 3px;
    background: #fff;
  }
  strong {
    font-weight: 600;
  }
  .detail {
    color: var(--ink-2);
  }
  @media (max-width: 759px) {
    .checklist {
      padding: 0;
      background: none;
      box-shadow: none;
      line-height: 1.4;
    }
    .checklist::before,
    .sheet-head,
    .detail,
    .box {
      display: none;
    }
    ul {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    li {
      display: block;
      padding: 7px 12px;
      background: var(--paper-2);
      border: 1px solid var(--rule);
      border-radius: 999px;
      font-size: 0.88rem;
    }
    strong {
      font-weight: 500;
    }
  }
</style>
