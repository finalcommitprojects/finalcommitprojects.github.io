---
import { wa } from '../data/site';
import Icon from './Icon.astro';
import Wordmark from './Wordmark.astro';
---

<header class="site-header">
  <div class="wrap row">
    <a href="/" class="home" aria-label="Final Commit, home"><Wordmark /></a>
    <nav aria-label="Main">
      <ul>
        <li><a href="/projects/">Project ideas</a></li>
        <li><a href="/#papers">Research papers</a></li>
        <li><a href="/#paying">How paying works</a></li>
        <li><a href="/#idea">Your idea</a></li>
        <li><a href="/#faq">FAQ</a></li>
      </ul>
    </nav>
    <a class="btn btn-small btn-wa head-cta" data-umami-event="whatsapp" data-umami-event-location="header" href={wa()}><Icon name="wa" />WhatsApp us</a>
  </div>
</header>

<style>
  .site-header {
    padding-block: 18px;
  }
  .row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px 28px;
  }
  .home {
    text-decoration: none;
  }
  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 22px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    font-size: 0.97rem;
    text-decoration: none;
    padding-block: 6px;
  }
  nav a:hover {
    text-decoration: underline;
    text-decoration-color: var(--red);
  }
  .head-cta {
    margin-left: auto;
  }
  @media (max-width: 759px) {
    nav {
      flex-basis: 100%;
      order: 3;
    }
    nav ul {
      gap: 2px 18px;
    }
    nav a {
      font-family: var(--f-mono);
      font-size: 0.82rem;
      letter-spacing: 0.02em;
      color: var(--ink-2);
    }
    .head-cta {
      display: none;
    }
  }
</style>
