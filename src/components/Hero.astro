---
import { site, wa } from '../data/site';
import { projects } from '../data/projects';
import Icon from './Icon.astro';
import Circle from './marks/Circle.astro';
import Tick from './marks/Tick.astro';

const checks = [
  ['₹0 until your guide approves the synopsis', 'Then three parts, each after you see the work.'],
  ['A video call before anything', `You talk to ${site.owner.name} directly. Ask whatever you want.`],
  ['A written quote', "The price is fixed before you pay, and it doesn't change."],
  ['Not repeated in your college', 'Nobody in your college and batch gets the same idea.'],
];

const n = projects.length;
---

<section class="hero sec" aria-labelledby="hero-title">
  <div class="wrap grid">
    <div class="copy">
      <p class="eyebrow"><span class="dot filled" aria-hidden="true"></span>Software projects for students · anywhere in India</p>
      <h1 id="hero-title">Your final-year project, built with you and <Circle>explained</Circle> till your viva.</h1>
      <p class="lede">
        We build web apps, Android apps, machine learning and AI projects with final-year students. Pick from {n} project ideas,
        bring your own, or get help with <a href="#started">the one you've already started</a>. The report, PPT and viva prep come with
        it.
      </p>
      <div class="cta-row">
        <a class="btn btn-wa" data-umami-event="whatsapp" data-umami-event-location="hero" href={wa()}><Icon name="wa" />WhatsApp us</a>
        <a class="btn btn-line" data-umami-event="browse-projects" data-umami-event-location="hero" href="/projects/">See the {n} project ideas <Icon name="arrow" /></a>
      </div>
      <p class="meta">Or call <a data-umami-event="call" data-umami-event-location="hero" href={site.phoneHref}>{site.phone}</a> · {site.hours}</p>
    </div>

    <aside class="side" aria-labelledby="before-title">
      <div class="card">
        <p class="card-head mono" id="before-title">Before you pay us anything</p>
        <ul>
          {
            checks.map(([t, d]) => (
              <li>
                <Tick />
                <span>
                  <strong>{t}</strong>
                  <span class="d">{d}</span>
                </span>
              </li>
            ))
          }
        </ul>
        <a class="card-link" href="#paying" data-umami-event="read-paying" data-umami-event-location="hero">How paying works <Icon name="arrow" /></a>
      </div>
    </aside>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(36px, 6vw, 84px);
  }
  .grid {
    display: grid;
    gap: 56px;
  }
  @media (min-width: 1000px) {
    .grid {
      grid-template-columns: minmax(0, 1.45fr) minmax(0, 0.85fr);
      align-items: center;
      gap: 56px;
    }
  }
  .copy {
    display: grid;
    gap: 22px;
    justify-items: start;
  }
  .eyebrow .dot {
    margin-top: 0.1em;
  }
  h1 {
    max-width: 13.5em;
  }
  .cta-row {
    align-items: center;
    margin-top: 6px;
  }
  .meta {
    color: var(--ink-2);
    font-size: 0.97rem;
  }
  .meta a {
    font-weight: 500;
    color: var(--ink);
  }

  /* "before you pay" card: an index card, red rule under the heading */
  .side {
    display: flex;
    justify-content: center;
  }
  .card {
    width: min(100%, 440px);
    padding: 22px 26px 24px;
    background: #fffdf9;
    border-radius: 6px;
    box-shadow:
      0 1px 1px rgba(31, 42, 68, 0.08),
      0 22px 40px -26px rgba(31, 42, 68, 0.55);
  }
  .card-head {
    margin: 0 0 14px;
    padding-bottom: 12px;
    border-bottom: 2px solid var(--red-soft);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .card ul {
    display: grid;
    gap: 14px;
    margin: 0 0 18px;
    padding: 0;
    list-style: none;
  }
  .card li {
    display: grid;
    grid-template-columns: 30px minmax(0, 1fr);
    align-items: start;
  }
  .card li :global(.tick) {
    margin-top: 2px;
  }
  .card strong {
    display: block;
    line-height: 1.35;
  }
  .card .d {
    display: block;
    color: var(--ink-2);
    font-size: 0.95rem;
    line-height: 1.45;
  }
  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
  }
  .card-link :global(svg) {
    width: 1.1em;
    height: 1.1em;
  }
</style>
