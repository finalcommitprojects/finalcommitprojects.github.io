---
import { site, wa } from '../data/site';
import { projects, no } from '../data/projects';
import Icon from './Icon.astro';
import Circle from './marks/Circle.astro';
import Stamp from './marks/Stamp.astro';

const n = projects.length;
---

<section class="hero sec" aria-labelledby="hero-title">
  <div class="wrap grid">
    <div class="copy">
      <p class="eyebrow"><span class="dot filled" aria-hidden="true"></span>Software projects for students · anywhere in India</p>
      <h1 id="hero-title">Your final-year project, built with you and <Circle>explained</Circle> till your viva.</h1>
      <p class="lede">
        We build web apps, Android apps, machine learning and AI projects. Pick one of our {n} or bring your own idea, and the
        report, PPT and viva prep come with it.
      </p>
      <div class="cta-row">
        <a class="btn btn-wa" data-umami-event="whatsapp" data-umami-event-location="hero" href={wa()}><Icon name="wa" />WhatsApp us</a>
        <a class="btn btn-line" data-umami-event="browse-projects" data-umami-event-location="hero" href="/projects/">See all {n} projects <Icon name="arrow" /></a>
        <p class="note price-note">
          <svg viewBox="0 0 64 34" aria-hidden="true"><path d="M61 8 C 44 1, 24 6, 9 23 M9 23 L 20 22.5 M9 23 L 11.5 12"></path></svg>
          price? depends on the project.<br />asking is free.
        </p>
      </div>
      <p class="meta">Or call <a data-umami-event="call" data-umami-event-location="hero" href={site.phoneHref}>{site.phone}</a> · {site.hours}</p>
    </div>

    <div class="side">
      <figure class="sticker">
        <p class="sticker-title">Record Note Book</p>
        <dl>
          <div><dt>Name</dt><dd>Final Commit</dd></div>
          <div><dt>Subject</dt><dd>Final-year &amp; mini projects</dd></div>
          <div><dt>Class</dt><dd>BE, B.Tech, MCA, BCA, B.Sc, M.Tech</dd></div>
          <div><dt>Branch</dt><dd>CSE, ISE, IT, AI&amp;ML, DS, ECE</dd></div>
          <div><dt>Roll No.</dt><dd>001 to {no(n)}</dd></div>
        </dl>
        <div class="hero-stamp"><Stamp id="hero-stamp" /></div>
      </figure>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(36px, 6vw, 84px);
  }
  .grid {
    display: grid;
    gap: 56px;
  }
  @media (min-width: 1000px) {
    .grid {
      grid-template-columns: minmax(0, 1.45fr) minmax(0, 0.85fr);
      align-items: center;
      gap: 56px;
    }
  }
  .copy {
    display: grid;
    gap: 22px;
    justify-items: start;
  }
  .eyebrow .dot {
    margin-top: 0.1em;
  }
  h1 {
    max-width: 13.5em;
  }
  .cta-row {
    align-items: center;
    margin-top: 6px;
  }
  .price-note {
    position: relative;
    margin: 0 0 0 4px;
    padding-left: 64px;
    font-size: 1.15rem;
    transform: rotate(-2.5deg);
  }
  .price-note svg {
    position: absolute;
    left: 0;
    top: 2px;
    width: 58px;
    height: 32px;
    overflow: visible;
  }
  .price-note path {
    fill: none;
    stroke: var(--red);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  @media (max-width: 759px) {
    .price-note {
      flex-basis: 100%;
      margin-top: 4px;
    }
    .price-note svg {
      transform: rotate(18deg);
      top: -6px;
    }
  }
  .meta {
    color: var(--ink-2);
    font-size: 0.97rem;
  }
  .meta a {
    font-weight: 500;
    color: var(--ink);
  }

  /* the notebook name label */
  .side {
    display: flex;
    justify-content: center;
  }
  .sticker {
    position: relative;
    width: min(100%, 420px);
    margin: 0 0 40px;
    padding: 30px 30px 34px;
    background: #fffdf9;
    border-radius: 18px;
    box-shadow:
      0 1px 1px rgba(31, 42, 68, 0.08),
      0 22px 40px -26px rgba(31, 42, 68, 0.55);
    transform: rotate(1.8deg);
  }
  .sticker::before {
    content: '';
    position: absolute;
    inset: 9px;
    border: 4px double rgba(42, 63, 157, 0.55);
    border-radius: 12px;
    pointer-events: none;
  }
  .sticker-title {
    margin-bottom: 18px;
    text-align: center;
    font-family: var(--f-display);
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ballpoint);
  }
  dl {
    display: grid;
    gap: 12px;
    margin: 0;
  }
  dl div {
    display: grid;
    grid-template-columns: 74px minmax(0, 1fr);
    align-items: end;
    gap: 8px;
  }
  dt {
    font-family: var(--f-mono);
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-2);
    padding-bottom: 3px;
  }
  dd {
    margin: 0;
    padding: 0 2px 1px;
    border-bottom: 1.5px dotted rgba(31, 42, 68, 0.5);
    font-family: var(--f-hand);
    font-size: 1.2rem;
    line-height: 1.3;
    color: var(--ballpoint);
  }
  .hero-stamp {
    position: absolute;
    right: -14px;
    bottom: -46px;
    width: 196px;
    color: var(--red);
    opacity: 0.88;
    transform: rotate(-9deg);
    mix-blend-mode: multiply;
  }
  .hero-stamp :global(svg) {
    width: 100%;
    height: auto;
  }
  @media (max-width: 520px) {
    .sticker {
      padding: 26px 22px 30px;
      transform: rotate(1deg);
    }
    .hero-stamp {
      right: 4px;
      bottom: -40px;
      width: 160px;
    }
  }
</style>
